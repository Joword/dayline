# Copy to `.env` and fill in. `.env` is git- and docker-ignored. Empty values count as unset.
# Every *_API_KEY can instead come from a file, e.g. ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key

# --- LLM endpoints (config/llm_endpoints.yaml names these variables) ---
ANTHROPIC_API_KEY=
DAYLINE_LLM_PROXY=http://proxy.corp:8080
CORP_LLM_API_KEY=
DAYLINE_CORP_LLM_URL=https://llm.corp.internal

# --- application ---
# dev | prod
DAYLINE_ENV=dev
DAYLINE_LOG_LEVEL=INFO
# json | text
DAYLINE_LOG_FORMAT=json
# zh | en
DAYLINE_DEFAULT_LANG=zh
DAYLINE_TIMEZONE=Asia/Shanghai
# CLI identity until login arrives in M2 (defaults to the OS user)
DAYLINE_USER=
# Required when DAYLINE_ENV=prod; clients send `Authorization: Bearer <token>`
DAYLINE_API_TOKEN=

# --- integrations (M3) ---
# Fernet key(s) for stored git / calendar credentials: `dl integrations keygen`.
# Keep it apart from database backups; comma-separate to rotate (first one encrypts).
DAYLINE_ENCRYPTION_KEY=
# proxy used when an integration's `proxy` is `auto` and the direct connection fails
DAYLINE_INTEGRATION_PROXY=
# Outlook via Microsoft Graph: an Azure app registration (public client, Calendars.Read)
DAYLINE_GRAPH_CLIENT_ID=
DAYLINE_GRAPH_TENANT=organizations
# collector only: the main system's service token (same value as its DAYLINE_API_TOKEN)
DAYLINE_COLLECTOR_TOKEN=

# --- DingTalk (M6): internal enterprise app with a robot in Stream mode ---
DAYLINE_DINGTALK_APP_KEY=
DAYLINE_DINGTALK_APP_SECRET=
# robot code; for an internal app's robot this is usually the AppKey
DAYLINE_DINGTALK_ROBOT_CODE=
# DingTalk log template used for one-way sync of confirmed reports
DAYLINE_DINGTALK_REPORT_TEMPLATE=日报
# public web address for links in DingTalk cards
DAYLINE_PUBLIC_URL=

# --- member tools (M7) ---
# Derives each tool's own token and signs the per-call grants; member tools are off while unset.
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Changing it rotates every tool token
# (re-run `dl tools compose` and redeploy the tools).
DAYLINE_TOOLS_SECRET=
# how tool containers reach the API on the `tools` network
DAYLINE_TOOLS_API_URL=http://api:8000
# egress proxy: optional upstream proxy for tools' outbound traffic (intranet)
DAYLINE_TOOLS_UPSTREAM_PROXY=

# --- MongoDB (host CLI; containers get mongodb://mongo:27017 from compose) ---
DAYLINE_MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
DAYLINE_MONGO_DB=dayline

# --- compose ---
# server | intranet | cloud  (deploy/profiles/*.env)
DAYLINE_PROFILE=server
DAYLINE_IMAGE_TAG=dev
DAYLINE_API_PORT=8000
MONGO_PORT=27017
MONGO_CACHE_GB=0.5
