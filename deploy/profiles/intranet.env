# Company intranet: outbound traffic through the corporate proxy, certificates issued by
# the company CA, corp LLM gateway reachable.
DAYLINE_ENV=prod
DAYLINE_LOG_FORMAT=json

# Outbound proxy for everything that honours the environment. The `anthropic-direct`
# endpoint uses `proxy: none` and ignores these on purpose; `anthropic-via-proxy` uses
# DAYLINE_LLM_PROXY.
HTTPS_PROXY=http://proxy.corp:8080
HTTP_PROXY=http://proxy.corp:8080
NO_PROXY=mongo,localhost,127.0.0.1,.corp.internal
DAYLINE_LLM_PROXY=http://proxy.corp:8080
DAYLINE_CORP_LLM_URL=https://llm.corp.internal

# Company CA bundle, mounted into the container (see the M4 prod compose):
# SSL_CERT_FILE=/certs/corp-ca.pem
# DAYLINE_TLS_CERT=/certs/dayline.crt
# DAYLINE_TLS_KEY=/certs/dayline.key

# gateway (Caddy)
DAYLINE_TLS_MODE=files
# DAYLINE_DOMAIN=dayline.corp.internal
# company certificate: deploy/certs/dayline.crt + dayline.key
