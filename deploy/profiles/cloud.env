# Cloud host: public domain; the gateway (M4, Caddy) obtains certificates automatically.
# Intranet sources (self-hosted GitLab, Coremail, corp LLM gateway) are not reachable from
# here: deploy the `collector` inside the intranet (M3) and expect corp-gateway to be skipped.
DAYLINE_ENV=prod
DAYLINE_LOG_FORMAT=json

# gateway (Caddy)
DAYLINE_TLS_MODE=auto
# DAYLINE_DOMAIN=dayline.example.com   # required for automatic certificates
