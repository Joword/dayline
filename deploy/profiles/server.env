# Own server. Pick one certificate mode when the gateway arrives (M4):
# automatic (public DNS name) or a mounted certificate.
DAYLINE_ENV=prod
DAYLINE_LOG_FORMAT=json
# DAYLINE_TLS_CERT=/certs/dayline.crt
# DAYLINE_TLS_KEY=/certs/dayline.key

# gateway (Caddy)
DAYLINE_TLS_MODE=internal
# DAYLINE_DOMAIN=dayline.example.com   # set DAYLINE_TLS_MODE=auto (public DNS) or files
